{
  "name": "dinosauria",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "audit": "node tools/run-audit.mjs",
    "audit:data": "node tools/run-audit.mjs --skip-smoke",
    "test": "node tools/smoke-test.mjs",
    "validate": "node tools/validate-data.mjs",
    "content:audit": "node tools/content-audit.mjs --out=content-audit.md --top=80",
    "factcheck": "node tools/factcheck-scan.mjs",
    "age:review": "node tools/age-review.mjs",
    "review:ledger": "node tools/scientific-review-ledger.mjs",
    "review:validate": "node tools/validate-scientific-reviews.mjs",
    "review:sources": "node tools/validate-review-sources.mjs",
    "narrative:check": "node tools/narrative-consistency-check.mjs --out=data/narrative-review-queue.md"
  },
  "devDependencies": {
    "playwright": "^1.61.1"
  }
}
